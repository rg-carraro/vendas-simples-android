<resources>
    <style name="AppTheme" parent="AppThemeBase" />

    <style name="AppThemeBase" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@color/color_app_background</item>
        <item name="android:navigationBarColor">@color/color_app_background</item>
        <item name="android:windowBackground">@color/color_app_background</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:colorAccent">@color/color_primary</item>
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_variant</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorAccent">@color/color_primary</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorControlNormal">@color/color_text_secondary</item>
        <item name="colorControlActivated">@color/color_primary</item>
        <item name="colorControlHighlight">@color/color_control_highlight</item>
        <item name="materialAlertDialogTheme">@style/VendasSimplesAlertDialog</item>
    </style>

    <style name="VendasSimplesAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:colorAccent">@color/color_primary</item>
        <item name="materialAlertDialogBodyTextStyle">@style/VendasSimplesDialogBodyText</item>
        <item name="buttonBarPositiveButtonStyle">@style/VendasSimplesDialogActionButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/VendasSimplesDialogActionButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/VendasSimplesDialogActionButton</item>
        <item name="shapeAppearanceOverlay">@style/VendasSimplesDialogShape</item>
    </style>

    <style name="VendasSimplesDialogActionButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dialog_action_text</item>
    </style>

    <style name="VendasSimplesDialogBodyText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="VendasSimplesDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
